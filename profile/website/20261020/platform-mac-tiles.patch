.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg> Mac</span><span class="nine-ed">Dark.Matter · Beta</span><span class="nine-st ">In qualification</span></div></div><div class="nine-tile"><img class="nine-orb" src="/assets/soul-cleo.png" alt="Cleo"><div class="nine-meta"><b>Cleo</b><span class="nine-os"><svg viewBox="0 0 48 48" aria-hidden="true" width="15" height="15" style="vertical-align:-2px"><circle cx="24" cy="24" r="13" fill="none" stroke="#E95420" stroke-width="6"/><circle cx="24" cy="6.5" r="4.6" fill="#fff"/><circle cx="8.8" cy="34.5" r="4.6" fill="#fff"/><circle cx="39.2" cy="34.5" r="4.6" fill="#fff"/></svg> Ubuntu</span><span class="nine-ed">Event.Horizon · Frontier</span><span class="nine-st ">Coming later</span></div></div><div class="nine-tile"><img class="nine-orb" src="/assets/platform/windows-cleo-720.webp" alt="Cleo"><div class="nine-meta"><b>Cleo</b><span class="nine-os"><svg viewBox="0 0 448 512" aria-hidden="true" width="14" height="15" style="vertical-align:-2px;fill:#dfe9f2"><path d="M0 93.7l183.6-25.3v177.4H0V93.7zm0 324.6l183.6 25.3V268.4H0v149.9zm203.8 28L448 480V268.4H203.8v177.9zm0-380.6v180.1H448V32L203.8 65.7z"/></svg> Windows</span><span class="nine-ed">Event.Horizon · Frontier</span><span class="nine-st ">In qualification</span></div></div><div class="nine-tile"><img class="nine-orb" src="/assets/soul-cleo.png" alt="Cleo"><div class="nine-meta"><b>Cleo</b><span class="nine-os"><svg viewBox="0 0 384 512" aria-hidden="true" width="13" height="15" style="vertical-align:-2px;fill:#dfe9f2"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg> Mac</span><span class="nine-ed">Event.Horizon · Frontier</span><span class="nine-st ">In qualification</span></div></div></div></section><section class="section wrap"><div class="section-head"><div><p class="eyebrow">ONE RELATIONSHIP, FIVE PLACES</p><h2>Different parts of life.<br>A shared thread.</h2></div><p>Today orients you. Home, Work and Life organize context. Atlas is where the conversation comes together.</p></div><div class="story-shell"><div class="story-top"><span class="brand"><span class="consciousness-mark" aria-hidden="true"></span><span class="wordmark-text"><span class="titan">TITAN</span><span class="dot">.</span><span class="atlas">ATLAS</span></span></span><p>A day with Maya · fictional records</p></div><div class="story-nav" role="tablist" aria-label="Explore a day with Atlas"><button id="story-tab-today" role="tab" aria-selected="true" aria-controls="story-panel-today" tabindex="0" data-story="today">Today</button><button id="story-tab-home" role="tab" aria-selected="false" aria-controls="story-panel-home" tabindex="-1" data-story="home">Home</button><button id="story-tab-work" role="tab" aria-selected="false" aria-controls="story-panel-work" tabindex="-1" data-story="work">Work</button><button id="story-tab-life" role="tab" aria-selected="false" aria-controls="story-panel-life" tabindex="-1" data-story="life">Life</button><button id="story-tab-atlas" role="tab" aria-selected="false" aria-controls="story-panel-atlas" tabindex="-1" data-story="atlas"><span class="wordmark-text"><span class="titan">TITAN</span><span class="dot">.</span><span class="atlas">ATLAS</span></span></button></div><div id="story-panel-today" role="tabpanel" aria-labelledby="story-tab-today" data-story-panel="today" ><div class="story-panel"><div class="story-message"><p class="eyebrow">THE DAY, IN CONTEXT</p><h3>One change worth a closer look.</h3><p>Harbor Kitchen’s flour delivery moved to Wednesday. Friday’s production plan still needs 26 bags. Let’s compare that with what is already on the shelf.</p><div class="actions"><a class="text-link" href="/how-it-works/">Inspect the draft order <span aria-hidden="true">↗</span></a></div><p class="note">A signal starts a question. It does not place an order.</p></div><aside class="story-evidence"><p class="eyebrow">BEHIND THE EXAMPLE</p><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Supplier update</strong><small>Delivery moved · Wednesday, 12:00</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Friday production plan</strong><small>26 bags required · plan revision 3</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Stock count</strong><small>8 bags available · counted yesterday</small></div></div><span class="badge design">Fictional example</span></aside></div></div><div id="story-panel-home" role="tabpanel" aria-labelledby="story-tab-home" data-story-panel="home" hidden><div class="story-panel"><div class="story-message"><p class="eyebrow">ROOM FOR THE REST OF LIFE</p><h3>Thursday has a small collision.</h3><p>Maya’s boiler service is booked for 09:00–11:00. Her kitchen planning call begins at 10:00. Atlas can put the two records together and prepare a question about a different appointment.</p><div class="actions"><a class="text-link" href="/your-world/family/">Explore family & home <span aria-hidden="true">↗</span></a></div><p class="note">The records are fictional. The proposed Home view remains in design.</p></div><aside class="story-evidence"><p class="eyebrow">BEHIND THE EXAMPLE</p><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Appointment confirmation</strong><small>Thursday · 09:00–11:00</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Personal calendar</strong><small>Kitchen planning call · 10:00</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Permission</strong><small>Draft a message · do not send</small></div></div><span class="badge design">Home concept</span></aside></div></div><div id="story-panel-work" role="tabpanel" aria-labelledby="story-tab-work" data-story-panel="work" hidden><div class="story-panel"><div class="story-message"><p class="eyebrow">A NEXT STEP YOU CAN INSPECT</p><h3>Eighteen bags. A draft, with its working.</h3><p>The plan needs 26 bags and the recorded stock is 8. That leaves 18 to order, at an example price of $24 each. Maya can review the $432 draft and every input before deciding what happens next.</p><div class="actions"><a class="text-link" href="/how-it-works/">Open the evidence <span aria-hidden="true">↗</span></a></div><p class="note">The calculation is inspectable. The purchasing decision belongs to Maya.</p></div><aside class="story-evidence"><p class="eyebrow">BEHIND THE EXAMPLE</p><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Quantity</strong><small>26 required − 8 available = 18 bags</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Cost</strong><small>18 × $24 = $432 before delivery or tax</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Decision</strong><small>Owner review required · nothing sent</small></div></div><span class="badge design">Worked example</span></aside></div></div><div id="story-panel-life" role="tabpanel" aria-labelledby="story-tab-life" data-story-panel="life" hidden><div class="story-panel"><div class="story-message"><p class="eyebrow">A LITTLE LESS TO KEEP IN YOUR HEAD</p><h3>A renewal, before it becomes a rush.</h3><p>The household policy record lists an October 20 renewal. Atlas can bring the date, source document, and an unanswered coverage question into view together, ready for Maya’s review.</p><div class="actions"><a class="text-link" href="/your-world/finance/">Explore a sourced financial view <span aria-hidden="true">↗</span></a></div><p class="note">An illustrative organizer, not a connected account or a financial recommendation.</p></div><aside class="story-evidence"><p class="eyebrow">BEHIND THE EXAMPLE</p><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Policy record</strong><small>Renewal date · October 20</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Open question</strong><small>Coverage change not yet confirmed</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>Boundary</strong><small>Read and organize · no account action</small></div></div><span class="badge design">Life concept</span></aside></div></div><div id="story-panel-atlas" role="tabpanel" aria-labelledby="story-tab-atlas" data-story-panel="atlas" hidden><div class="story-panel"><div class="story-message"><p class="eyebrow">ASK WHY. FOLLOW THE THREAD.</p><h3>The answer keeps its sources beside it.</h3><p>“Why did you flag Friday?” Because the supplier changed the delivery, the production plan needs 26 bags, and the latest stock count records 8. Correct the count and the draft should change with it.</p><div class="actions"><a class="text-link" href="/trust/">See the trust boundaries <span aria-hidden="true">↗</span></a></div><p class="note">Sources, interpretation, and permission remain separate parts of the record.</p></div><aside class="story-evidence"><p class="eyebrow">BEHIND THE EXAMPLE</p><div class="evidence-item"><span class="evidence-dot"></span><div><strong>What changed</strong><small>Supplier message linked to Friday’s plan</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>What was inferred</strong><small>18 additional bags based on recorded inputs</small></div></div><div class="evidence-item"><span class="evidence-dot"></span><div><strong>What remains yours</strong><small>Review, correction, and the final decision</small></div></div><span class="badge design">Continuity example</span></aside></div></div><div class="story-bottom"><span>Interactive product illustration · not a connected Atlas instance</span><a href="/atlas/upgrades/">What is actually in development? ↗</a></div></div></section><section class="section wrap"><div class="section-head"><div><p class="eyebrow">THE RECORD BEHIND THE ANSWER</p><h2>Memory needs more<br>than a good summary.</h2></div><p></p></div><div class="cards-3"><article class="info-card"><p class="eyebrow">CONTINUITY</p><h3>Carry the context.</h3><p>Preserve the history of a conversation and the decisions that followed it. The memory and identity story is associated with Titan.Mnemos and Mayfly.</p></article><article class="info-card"><p class="eyebrow">EVIDENCE</p><h3>Keep the source.</h3><p>Distinguish a retrieved record, a personal statement and an inference. Atlantis names the evidence and correction layer in the public Atlas record.</p></article><article class="info-card"><p class="eyebrow">CONTROL</p><h3>Keep the person in charge.</h3><p>Steering, bounded permission and recorded outcomes make the relationship inspectable. Helm and ConKer appear in the original technology record.</p></article></div><div class="principle-band"><p>Technology names describe the system’s public vocabulary. <strong>They do not, on their own, establish release acceptance.</strong> <a class="text-link" href="/atlas/upgrades/">Read the current status ↗</a></p></div></section><section class="section wrap"><div class="section-head"><div><p class="eyebrow">WHAT COMES NEXT</p><h2>More perspective.<br>More considered interruptions.</h2></div><p>These directions remain in design.</p></div><div class="cards-3"><article class="info-card"><span class="badge design">Sense · In design</span><h3 style="margin-top:22px">Notice what matters.</h3><p>Evaluate meaningful changes and patterns, with source coverage and permission checks before an insight reaches you.</p></article><article class="info-card"><span class="badge design">Council · In design</span><h3 style="margin-top:22px">Invite another perspective.</h3><p>Bring bounded contributions together while keeping their sources, disagreements and limits visible.</p></article><article class="info-card"><span class="badge design">Reflection · In design</span><h3 style="margin-top:22px">Learn with care.</h3><p>Review a settled period of work without silently turning a personal interpretation into an accepted fact.</p></article></div></section></main><section class="cta wrap"><div><p class="eyebrow">START WITH YOUR WORLD</p><h2>What should your Atlas<br><em>carry forward?</em></h2></div><a class="button" href="/contact/">Let’s talk about it <span aria-hidden="true">↗</span></a></section><!-- titan-footer-standard:r12 -->
